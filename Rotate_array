class Solution(object):
    def rotate(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        # nums = nums[-1] + nums[:len(nums)-1] thhappu 

        for i in range(1, k+1):
            nums[:] = nums[-1:] + nums[:-1]  # Rotate 1 step to the right by taking the last element and moving it to the front
            print("rotate {} steps to the right: {}".format(i, nums))
