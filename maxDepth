class Solution:
    def maxDepth(self, s: str) -> int:
        stk = []
        maxx = 0
        counter = 0
        for i in s :
            if i == "(":
                stk.append(i)
                counter +=1
            elif i == ")" and stk[-1] == "(":
                counter -=1
            if counter > maxx :
                maxx = counter
        
        return maxx 
