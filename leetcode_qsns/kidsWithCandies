class Solution:
    def kidsWithCandies(self, candies: List[int], extraCandies: int) -> List[bool]:
        res = len(candies)*[False]
        maxx =max(candies)
        for i in range(0 , len(candies)) :
            if candies[i]+ extraCandies>= maxx :
                res[i] = True
        return res
