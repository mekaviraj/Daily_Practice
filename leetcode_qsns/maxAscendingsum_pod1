class Solution(object):
    def maxAscendingSum(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """

        maxSum = 0
        currentSum = nums[0]
        
        for i in range(1, len(nums)):
            if nums[i] > nums[i - 1]:
                currentSum += nums[i]
            else:
                maxSum = max(maxSum, currentSum)
                currentSum = nums[i]
        
        maxSum = max(maxSum, currentSum)
        
        return maxSum
