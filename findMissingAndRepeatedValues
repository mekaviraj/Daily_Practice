class Solution:
    def findMissingAndRepeatedValues(self, grid: List[List[int]]) -> List[int]:
        n = len(grid)
        seen = set()
        
        repeated = -1
        for row in grid:
            for num in row:
                if num in seen:
                    repeated = num
                else:
                    seen.add(num)
        
        total_numbers = n * n
        missing = -1
        for i in range(1, total_numbers + 1):
            if i not in seen:
                missing = i
                break
        
        return [repeated, missing]
